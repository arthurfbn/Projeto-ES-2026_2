// Referência histórica: modelo da disciplina de Banco de Dados (2026/2). NÃO executar.
// O modelo atual vive nas migrations em apps/api/prisma. Diferenças: ver docs/referencias/README.md e ADRs 0011–0014, 0017–0019.

// ─── Enums ────────────────────────────────────────────────────────────────────

Enum user_role {
  admin
  barber
  client
}

Enum permission_level {
  owner        // criou a barbearia, não pode ser removido
  manager      // admin pleno
  receptionist // só gerencia agenda
}

Enum appointment_status {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

Enum commission_type {
  percentage   // % sobre o valor do serviço
  fixed        // valor fixo por atendimento
  tiered       // faixa progressiva (ex: acima de R$2k/mês → 40%)
}

Enum commission_scope {
  all_services     // aplica a todos os serviços
  specific_service // aplica só a um serviço específico
}

// ─── Usuários ─────────────────────────────────────────────────────────────────

Table users {
  id            uuid         [pk, default: `gen_random_uuid()`]
  name          varchar(120) [not null]
  email         varchar(255) [unique, not null]
  phone         varchar(20)
  password_hash varchar(255) [not null]
  role          user_role    [not null, default: 'client']
  avatar_url    varchar(500)
  is_active     boolean      [not null, default: true]
  created_at    timestamp    [not null, default: `now()`]
  updated_at    timestamp    [not null, default: `now()`]

  indexes {
    email [unique]
    role
  }
}

// ─── Barbearias ───────────────────────────────────────────────────────────────

Table barbershops {
  id         uuid         [pk, default: `gen_random_uuid()`]
  name       varchar(120) [not null]
  slug       varchar(80)  [unique, not null]
  address    varchar(255)
  city       varchar(80)
  phone      varchar(20)
  logo_url   varchar(500)
  is_active  boolean      [not null, default: true]
  created_at timestamp    [not null, default: `now()`]

  indexes {
    slug [unique]
  }
}

// Vínculo N:N — um user pode administrar várias barbearias
// e uma barbearia pode ter vários admins com níveis diferentes
Table barbershop_admins {
  user_id          uuid             [not null, ref: > users.id]
  barbershop_id    uuid             [not null, ref: > barbershops.id]
  permission_level permission_level [not null, default: 'manager']
  added_by         uuid             [ref: > users.id]
  added_at         timestamp        [not null, default: `now()`]

  indexes {
    (user_id, barbershop_id) [pk]
    barbershop_id
  }
}

// ─── Vínculo barbeiro ↔ barbearia (N:N) ──────────────────────────────────────
// is_exclusive: ESTA barbearia exige que o barbeiro só trabalhe aqui
// A verificação de conflito é responsabilidade da aplicação

Table barber_memberships {
  user_id       uuid      [not null, ref: > users.id]
  barbershop_id uuid      [not null, ref: > barbershops.id]
  is_exclusive  boolean   [not null, default: false]
  // null = sem restrição de turno
  // 'morning' | 'afternoon' | 'evening' = só pode ter horários neste turno
  allowed_shift varchar(20)
  is_accepting  boolean   [not null, default: true]
  is_active     boolean   [not null, default: true]
  bio           text
  hired_at      date
  approved_by   uuid      [ref: > users.id]
  created_at    timestamp [not null, default: `now()`]
  updated_at    timestamp [not null, default: `now()`]

  indexes {
    (user_id, barbershop_id) [pk]
    (user_id, is_active)     // "quantas barbearias ativas este barbeiro tem?"
    barbershop_id
  }
}

// ─── Disponibilidade do barbeiro por barbearia ────────────────────────────────
// Cada bloco pertence a uma barbearia específica
// Cruzar user_id + weekday (sem filtrar barbershop_id) detecta conflitos entre barbearias

Table barber_availability {
  id            uuid      [pk, default: `gen_random_uuid()`]
  user_id       uuid      [not null, ref: > users.id]
  barbershop_id uuid      [not null, ref: > barbershops.id]
  weekday       int       [not null]  // 0=dom … 6=sab
  start_time    time      [not null]
  end_time      time      [not null]
  valid_from    date
  valid_until   date      // null = indefinido

  indexes {
    (user_id, barbershop_id)
    (user_id, weekday)       // join rápido para detectar conflito cross-barbearia
  }
}

// ─── Serviços ─────────────────────────────────────────────────────────────────

Table services {
  id            uuid          [pk, default: `gen_random_uuid()`]
  barbershop_id uuid          [not null, ref: > barbershops.id]
  name          varchar(120)  [not null]
  description   text
  price         decimal(10,2) [not null]
  duration_min  int           [not null]
  is_active     boolean       [not null, default: true]

  indexes {
    barbershop_id
  }
}

// Quais serviços cada barbeiro realiza em cada barbearia
// PK tripla: mesmo serviço pode ter preço diferente por barbearia
Table barber_services {
  user_id       uuid          [not null, ref: > users.id]
  service_id    uuid          [not null, ref: > services.id]
  barbershop_id uuid          [not null, ref: > barbershops.id]
  custom_price  decimal(10,2) // null = usa preço padrão do serviço

  indexes {
    (user_id, service_id, barbershop_id) [pk]
  }
}

// ─── Regras de comissão ───────────────────────────────────────────────────────
// Separadas do vínculo — múltiplas regras por barbeiro/barbearia
// Prioridade na aplicação: scope específico sobrepõe geral; valid_from mais recente vence

Table commission_rules {
  id            uuid             [pk, default: `gen_random_uuid()`]
  user_id       uuid             [not null, ref: > users.id]
  barbershop_id uuid             [not null, ref: > barbershops.id]
  service_id    uuid             [ref: > services.id]           // null = aplica a todos
  scope         commission_scope [not null, default: 'all_services']
  type          commission_type  [not null]
  value         decimal(10,2)    [not null]                     // % ou R$ conforme type
  tier_threshold decimal(10,2)                                  // faturamento mínimo mensal para tiered
  valid_from    date             [not null, default: `now()`]
  valid_until   date                                            // null = vigente indefinidamente
  created_by    uuid             [ref: > users.id]
  created_at    timestamp        [not null, default: `now()`]

  indexes {
    (user_id, barbershop_id)
    (user_id, barbershop_id, service_id)
    valid_from
  }
}

// ─── Agendamentos ─────────────────────────────────────────────────────────────

Table appointments {
  id             uuid               [pk, default: `gen_random_uuid()`]
  client_id      uuid               [not null, ref: > users.id]
  barber_user_id uuid               [not null, ref: > users.id]
  barbershop_id  uuid               [not null, ref: > barbershops.id]
  service_id     uuid               [not null, ref: > services.id]
  starts_at      timestamp          [not null]
  ends_at        timestamp          [not null]
  status         appointment_status [not null, default: 'pending']
  price_snapshot decimal(10,2)      [not null]  // valor congelado no momento do agendamento
  notes          text
  created_at     timestamp          [not null, default: `now()`]

  indexes {
    client_id
    barber_user_id
    barbershop_id
    (barber_user_id, starts_at)  // verificação de conflito cross-barbearia
    (barbershop_id, starts_at)   // agenda do dia da barbearia
  }
}
