# Copie para apps/api/.env (nunca commite o .env)
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Postgres local do docker compose
DATABASE_URL=postgresql://shavey:shavey@localhost:5432/shavey

# Opcional: sem DSN, os erros vão para o log (ConsoleErrorReporter)
SENTRY_DSN=

# Origens extras aceitas em POST/PUT/DELETE (checagem de Origin, ADR-0006), separadas por vírgula.
# Local não precisa: o proxy do Vite mantém o Host. No Railway: a URL da Vercel do ambiente.
WEB_ORIGINS=

# Senha das contas da seed da demo (pnpm db:seed). Nunca no código: o repositório é público.
SEED_DEMO_PASSWORD=
